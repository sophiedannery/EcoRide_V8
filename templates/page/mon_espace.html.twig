{% extends 'base.html.twig' %}

{% block title %}Mon Espace
{% endblock %}

{% block body %}

	<div classs="mt-5">
		<h1 class="text-center">Bonjour
			{{ user.pseudo }}
			!</h1>

		<div class="row mt-5">

			<div class="col-md-6">
				<h3>
					<i class="bi bi-person-vcard"></i>
					Mes infos
				</h3>

				<div class="card shadow-sm mb-4">

					<div class="card-body">

						<ul class="list-unstyled">
							<li>
								<strong>Email :</strong>
								{{ user.email }}</li>
							<li>
								<strong>Statut :</strong>
								{{ user.type }}</li>
							<li>
								<strong>Crédits :</strong>
								{{ user.credit }}</li>
						</ul>
					</div>

				</div>

			</div>

			<div class="col-md-6">
				<h3>
					<i class="bi bi-car-front-fill"></i>
					Mes Voitures</h3>
				{% if voitures is empty %}
					<p>Vous n'avez pas encore ajouté de voiture.</p>
				{% else %}
					<div class="card-deck">
						{% for voiture in voitures %}
							<div class="card shadow-sm mb-4">
								<div class="card-body">
									<h5 class="card-title">{{ voiture.marque }}
										{{ voiture.modele }}</h5>
									<p class="card-text">{{ voiture.plaqueImmatriculation }}
										|
										{{ voiture.energie }}</p>
									{% if voiture.energie == 'electrique' %}
										<span class="badge bg-success">Véhicule écologique
											<i class="fa-solid fa-leaf"></i>
										</span>
									{% endif %}
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
				<a href="{{ path('app_ajout_voiture') }}" class="btn btn-primary mt-3">Ajouter une voiture</a>
			</div>
		</div>
	</div>

	<h3 class="mt-5">
		<i class="bi bi-key-fill"></i>
		Mes trajets à venir (chauffeur)</h3>
	<div class="row row-cols-1 row-cols-md-3 my-3 text-center">

		{% if covoiturages is empty %}
			<p>Vous n'avez pas encore ajouté de trajet.</p>
		{% else %}

			{% for covoiturage in covoiturages %}
				<div class="col">
					<div class="card mb-4 rounded-3 shadow-sm">
						<div class="card-header py-3">
							<h4 class="my-0 fw-normal">{{ covoiturage.dateHeureDepart|date('d/m/Y') }}
								<br>
								{{ covoiturage.dateHeureDepart|date('H:i') }}</h4>
						</div>
						<div class="card-body">
							<h1 class="card-title pricing-card-title">{{ covoiturage.depart }}<small class="text-body-secondary fw-light">

									<br>
									{{ covoiturage.arrivee }}</small>
							</h1>
							{% if covoiturage.passagers is empty %}
								Aucun passager pour le moment
							{% else %}
								<h4 class="mt-5 text-start">
									<strong>Passagers :</strong>
								</h4>
								<ul class="list-unstyled mt-3 mb-4">
									{% for passager in covoiturage.passagers %}
										<li>-
											{{ passager.pseudo }}</li>
									{% endfor %}
								</ul>
							{% endif %}
							{% if covoiturage.statut == '1' %}
								<button type="button" class="w-100 btn btn-lg btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal{{ covoiturage.id }}">Démarrer</button>
							{% endif %}

							{% if covoiturage.statut == '2' %}
								<button type="button" class="w-100 btn btn-lg btn-outline-primary" data-bs-toggle="modal" data-bs-target="#exampleModal2{{ covoiturage.id }}">Arrivée à destination</button>
							{% endif %}

							{% if covoiturage.statut == '3' %}
								<button type="button" class="w-100 btn btn-lg btn-outline-primary" disabled>Trajet en attente de validation</button>
							{% endif %}

							{% if covoiturage.statut == '4' %}
								<button type="button" class="w-100 btn btn-lg btn-outline-primary" disabled>Trajet terminé</button>
							{% endif %}

							{% if covoiturage.statut == '5' %}
								<button type="button" class="w-100 btn btn-lg btn-primary" disabled>Trajet signalé</button>
							{% endif %}
						</div>
					</div>
				</div>

				<!-- Modal -->
				<div class="modal fade" id="exampleModal{{ covoiturage.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h1 class="modal-title fs-5" id="exampleModalLabel">C'est parti !</h1>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								Voulez-vous démarrer ce trajet ?
							</div>
							<div class="modal-footer">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
								<a href="{{ path('app_demarrer_trajet', {'id': covoiturage.id}) }}" class="btn btn-primary mt-3">Démarrer</a>
							</div>
						</div>
					</div>
				</div>

				<!-- Modal 2 -->
				<div class="modal fade" id="exampleModal2{{ covoiturage.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h1 class="modal-title fs-5" id="exampleModalLabel">Bien arrivés ?</h1>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								Voulez-vous marquer ce trajet comme terminé ?
							</div>
							<div class="modal-footer">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Pas encore</button>
								<a href="{{ path('app_arreter_trajet', {'id': covoiturage.id}) }}" class="btn btn-primary mt-3">Arrivée à destination</a>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		{% endif %}

	</div>

	<a href="{{ path('app_ajout_trajet') }}" class="btn btn-primary mt-3">Ajouter un trajet</a>
	<a href="{{ path('app_historique') }}" class="btn btn-secondary mt-3">Historique de mes trajets</a>


	<h3 class="mt-5">
		<i class="bi bi-suitcase-lg-fill"></i>
		Mes trajets à venir (passager)</h3>
	<div class="row row-cols-1 row-cols-md-3 my-3 text-center">

		{% if covoituragesPassager is empty %}
			<p>Vous ne participez à aucun trajet pour le moment.</p>
		{% else %}

			{% for covoituragePassager in covoituragesPassager %}
				<div class="col">
					<div class="card mb-4 rounded-3 shadow-sm">
						<div class="card-header py-3">
							<h4 class="my-0 fw-normal">{{  covoituragePassager.dateHeureDepart|date('d/m/Y') }}
								<br>
								{{ covoituragePassager.dateHeureDepart|date('H:i') }}</h4>
						</div>
						<div class="card-body">
							<h1 class="card-title pricing-card-title">{{ covoituragePassager.depart }}<small class="text-body-secondary fw-light">
									<br>
									{{ covoituragePassager.arrivee }}</small>
							</h1>
							<p>
								<strong>Prix :</strong>
								{{ covoituragePassager.prixPersonne }}
								crédits</p>

							{% if covoituragePassager.statut == '3' %}
								<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#exampleModal3{{ covoituragePassager.id }}">Valider ce trajet</button>
							{% endif %}

							{% if covoituragePassager.statut == '4' %}
								<button type="button" class="btn btn-secondary" disabled>Trajet terminé</button>
							{% endif %}

							{% if covoituragePassager.statut == '5' %}
								<button type="button" class="btn btn-secondary" disabled>Trajet signalé</button>
							{% endif %}
							<!-- Modal 3 -->
							<div class="modal fade" id="exampleModal3{{ covoituragePassager.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
								<div class="modal-dialog">
									<div class="modal-content">
										<div class="modal-header">
											<h1 class="modal-title fs-5" id="exampleModalLabel">Bien arrivés ?</h1>
											<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
										</div>
										<div class="modal-body">
											Voulez-vous marquer ce trajet comme terminé ?
										</div>
										<div class="modal-footer">
											<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Pas encore</button>
											<a href="{{ path('app_valider_trajet', {'id': covoituragePassager.id}) }}" class="btn btn-primary mt-3">Bien arrivé !</a>
											<a href="{{ path('app_signaler_trajet', {'id': covoituragePassager.id}) }}" class="btn btn-primary mt-3">Signaler un problème</a>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>


			{% endfor %}
		{% endif %}

	</div>
	<a href="{{ path('app_covoiturages_v2') }}" class="btn btn-primary mt-3">Chercher un covoiturage</a>
	<a href="{{ path('app_historique') }}" class="btn btn-secondary mt-3">Historique de mes trajets</a>


{% endblock %}
