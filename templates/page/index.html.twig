{% extends 'base.html.twig' %}

{% block title %}EcoRide
{% endblock %}

{% block body %}
	<div class="row flex-lg-row-reverse align-items-center g-5 py-5">
		<div class="col-10 col-sm-8 col-lg-6">
			<img src="{{ asset('assets/images/image (2).jpg')}}" class="d-block mx-lg-auto img-fluid" width="700" height="500" loading="lazy">
		</div>
		<div class="col-lg-6">
			<h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">Responsive left-aligned hero with image</h1>
			<p class="lead">Quickly design and customize responsive mobile-first sites with Bootstrap, the world’s most popular front-end open source toolkit, featuring Sass variables and mixins, responsive grid system, extensive prebuilt components, and powerful JavaScript plugins.</p>
			<div class="d-grid gap-2 d-md-flex justify-content-md-start">
				<button type="button" class="btn btn-primary btn-lg px-4 me-md-2">Primary</button>
				<button type="button" class="btn btn-outline-secondary btn-lg px-4">Default</button>
			</div>
		</div>
	</div>

	<div>
		<h2>Rechercher un trajet :</h2>
		<form method="GET" action="{{ path('search_covoiturage') }}">
			<div class="row">
				<div class="col-md-3">
					<input type="text" name="depart" placeholder="Ville de départ" required class="form-control">
				</div>
				<div class="col-md-3">
					<input type="text" name="arrivee" placeholder="Ville d'arrivée" required class="form-control">
				</div>
				<div class="col-md-3">
					<input type="date" name="date" required class="form-control">
				</div>
				<div class="col-md-3">
					<button type="submit" class="btn btn-primary">Rechercher</button>
				</div>
			</div>
		</form>
	</div>
{% endblock %}
