{% extends 'base.html.twig' %}

{% block title %}Hello PageController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">

		<h1>
			{% if app.user %}
				Hello
				{{ app.user.email }}
				!
			{% else %}
				Hello, Guest!
			{% endif %}
		</h1>


	</div>
{% endblock %}
