{% extends 'base.html.twig' %}

{% block title %}Covoiturages
{% endblock %}

{% block body %}

	<h1 class="mb-5">Liste des covoiturages</h1>

	<!-- Afficher le formulaire de filtre -->
	<div class="mb-4">
		<h4>Filtrer les covoiturages</h4>
		<form method="get">
			{{ form_start(filterForm) }}
			{{ form_row(filterForm.prixMax) }}
			{{ form_row(filterForm.isEcologique) }}
			{{ form_end(filterForm) }}
		</form>
	</div>

	{% if covoiturages is not empty %}
		<div class="col-md-12">
			<div class="row text-center g-4">
				{% for covoiturage in covoiturages %}

					<div class="col-md-4 my-2 d-flex">
						<div class="card w-100">
							<div class="card-body d-flex flex-column text-start">
								<h5 class="card-title">{{ covoiturage.depart }}
									-
									{{ covoiturage.arrivee }}</h5>
								<p class="card-text">
									<i class="bi bi-person-circle"></i>
									Chauffeur :
									{{ covoiturage.chauffeur.pseudo }}
									| Note :
								</p>
								<p class="card-text">
									<i class="bi bi-calendar-check"></i>
									Départ :
									{{ covoiturage.dateHeureDepart|date('d/m/Y H:i') }}</p>
								<p class="card-text">
									<i class="bi bi-calendar-check"></i>
									Arrivée :
									{{ covoiturage.dateHeureArrivee|date('d/m/Y H:i') }}</p>
								<p class="card-text">
									<i class="bi bi-clock-fill"></i>
									Durée :
									{{ covoiturage.durationFormatted }}
								</p>
								<p class="card-text">
									<i class="bi bi-piggy-bank-fill"></i>
									Prix :
									{{ covoiturage.prixPersonne }}
									crédits</p>
								<p class="card-text">
									<i class="bi bi-suitcase-fill"></i>
									Place disponibles :
									{{ covoiturage.nbPlace }}
								</p>
								{% if covoiturage.isEcologique %}
									<p class="card-text">
										<i class="bi bi-ev-front-fill"></i>
										Trajet écologique</p>
								{% endif %}
								<div class="mt-auto">
									<a href="{{ path('app_covoiturages_show', {'id': covoiturage.id}) }}" class="btn btn-primary ">Détails</a>
								</div>
								{% if covoiturage.nbPlace <= 0 %}
									<button type="submit" class="btn btn-secondary mt-3" disabled>Plus de places disponibles</button>
								{% else %}
									<form method="post" action="{{ path('app_participer_trajet', {'id': covoiturage.id}) }}">
										<button type="submit" class="btn btn-primary mt-3">Participer à ce trajet</button>
									</form>
								{% endif %}
							</div>
						</div>
					</div>

				{% endfor %}
			</div>
		</div>
	{% else %}
		<h3>Aucun covoiturage disponible</h3>
	{% endif %}

{% endblock %}
