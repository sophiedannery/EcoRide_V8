{% extends 'base.html.twig' %}

{% block title %}Covoiturages
{% endblock %}

{% block body %}

	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}

	{% for message in app.flashes('error') %}
		<div class="alert alert-danger">
			{{ message }}
		</div>
	{% endfor %}

	<h1>Liste des covoiturages</h1>
	<table class="table table-hover">
		<thead>
			<tr>
				<th>Départ</th>
				<th>Arrivée</th>
				<th>Date</th>
				<th>Chauffeur</th>
				<th>Nombre de place</th>
				<th>Prix</th>
				<th>Energie</th>
				<th>Participer</th>
			</tr>
		</thead>
		<tbody>
			{% for covoiturage in covoiturages %}
				<tr>
					<td>{{ covoiturage.depart }}</td>
					<td>{{ covoiturage.arrivee }}</td>
					<td>{{ covoiturage.dateHeureDepart|date('d/m/Y H:i') }}</td>
					<td>
						{{ covoiturage.chauffeur.pseudo }}
					</td>
					<td>
						{{ covoiturage.nbPlace }}
					</td>
					<td>
						{{ covoiturage.prixPersonne }}
						crédits
					</td>
					<td>
						{% if covoiturage.isEcologique %}
							<span class="badge bg-success">Trajet écologique</span>
						{% endif %}
					</td>
					<td>
						{% if covoiturage.nbPlace <= 0 %}
							<button type="submit" class="btn btn-secondary" disabled>Plus de places disponibles</button>
						{% else %}
							<form method="post" action="{{ path('app_participer_trajet', {'id': covoiturage.id}) }}">
								<button type="submit" class="btn btn-primary">Participer à ce trajet</button>
							</form>
						{% endif %}
					</td>
				</tr>
			</td>
		</tbody>
	</tr>
{% else %}
	<tr>
		<td colspan="4">Aucun covoiturage disponible.</td>
	</tr>
{% endfor %}</tbody></table>{% endblock %}
